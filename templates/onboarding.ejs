<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#1C6F38">
    <title>Welcome to <%= app_name %></title>
    <!--[if !mso]><!-->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!--<![endif]-->
    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');

        body,
        table,
        td,
        a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
            border: 0;
            outline: none;
            text-decoration: none;
        }

        table {
            border-collapse: collapse !important;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            height: 100% !important;
            background-color: #F8FAF8;
        }

        a[x-apple-data-detectors],
        u+#body a,
        #MessageViewBody a {
            color: inherit !important;
            text-decoration: none !important;
            font-size: inherit !important;
            font-family: inherit !important;
            font-weight: inherit !important;
            line-height: inherit !important;
        }
    </style>
</head>

<body id="body" style="margin:0;padding:0;background-color:#F8FAF8;width:100%;">
    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#F8FAF8" style="width:100%;background-color:#F8FAF8;">
        <tr>
            <td align="center" valign="top" style="padding:24px 12px;">
                <!--[if mso]>
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="560"><tr><td>
                <![endif]-->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width:100%;max-width:560px;background-color:#ffffff;border:1px solid #DCEFE2;border-radius:12px;">

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding:28px 24px 20px 24px;background-color:#F8FAF8;border-bottom:1px solid #DCEFE2;border-radius:12px 12px 0 0;">
                            <% if (logo_url) { %>
                                <img src="<%= logo_url %>" alt="<%= app_name %> Logo" width="120" style="display:block;margin:0 auto;width:120px;max-width:120px;height:auto;">
                            <% } else { %>
                                <p style="margin:0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;color:#1C6F38;"><%= app_name %></p>
                            <% } %>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:32px 24px 8px 24px;font-family:'Montserrat',Helvetica,Arial,sans-serif;">
                            <h1 style="margin:0 0 8px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;line-height:1.3;color:#124E2A;text-align:center;">
                                Welcome to <%= app_name %>!
                            </h1>
                            <p style="margin:0 0 24px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;line-height:1.5;color:#585858;text-align:center;">
                                Your community hub for businesses, jobs &amp; marketplace
                            </p>
                            <p style="margin:0 0 12px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#282B36;">
                                Hello <strong><%= name %></strong>,
                            </p>
                            <p style="margin:0 0 24px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#585858;">
                                Thanks for joining <%= app_name %>. Your account is ready — open the app and start connecting with your community.
                            </p>
                        </td>
                    </tr>

                    <!-- Account email -->
                    <tr>
                        <td style="padding:0 24px 24px 24px;">
                            <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;background-color:#DCEFE2;border-left:3px solid #1C6F38;">
                                <tr>
                                    <td style="padding:16px 18px;font-family:'Montserrat',Helvetica,Arial,sans-serif;">
                                        <p style="margin:0;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#1C6F38;">
                                            Signed up with
                                        </p>
                                        <p style="margin:6px 0 0 0;font-size:15px;font-weight:600;line-height:1.5;color:#124E2A;">
                                            <%= email %>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Next steps -->
                    <tr>
                        <td style="padding:0 24px 8px 24px;font-family:'Montserrat',Helvetica,Arial,sans-serif;">
                            <p style="margin:0 0 12px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#282B36;">
                                Get started in a few steps:
                            </p>
                            <p style="margin:0 0 8px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:#585858;">
                                &bull;&nbsp; Complete your profile so members can recognize you
                            </p>
                            <p style="margin:0 0 8px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:#585858;">
                                &bull;&nbsp; Browse the business directory and marketplace
                            </p>
                            <p style="margin:0 0 8px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:#585858;">
                                &bull;&nbsp; Explore jobs and opportunities in the community
                            </p>
                            <p style="margin:0 0 24px 0;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.7;color:#585858;">
                                &bull;&nbsp; Share your referral code and invite others to join
                            </p>
                        </td>
                    </tr>

                    <!-- Note -->
                    <tr>
                        <td style="padding:0 24px 24px 24px;">
                            <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%;background-color:#F8FAF8;border-left:3px solid #4FAE68;">
                                <tr>
                                    <td style="padding:12px 14px;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.55;color:#585858;">
                                        If you did not create this account, please contact our support team right away.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Sign-off -->
                    <tr>
                        <td style="padding:0 24px 28px 24px;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#282B36;">
                            We're glad to have you here.<br><br>
                            Welcome aboard,<br>
                            The <strong style="color:#1C6F38;"><%= app_name %></strong> Team
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding:18px 24px 24px 24px;border-top:1px solid #DCEFE2;font-family:'Montserrat',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#9CA3AF;">
                            &copy; <%= new Date().getFullYear() %> <%= app_name %>. All rights reserved.
                        </td>
                    </tr>

                </table>
                <!--[if mso]>
                </td></tr></table>
                <![endif]-->
            </td>
        </tr>
    </table>
</body>

</html>
